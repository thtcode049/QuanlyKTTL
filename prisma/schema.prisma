datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COACH
}

enum AttendanceStatus {
  PRESENT // Đi học -> Tính phí
  ABSENT  // Nghỉ -> Không tính phí
}

enum InvoiceStatus {
  PENDING
  PAID
}

model Branch {
  id        String      @id @default(uuid())
  name      String      // VD: Cơ sở 1 - Bạch Mai, Cơ sở 2 - Thái Hà
  address   String
  phone     String?
  classes   Classroom[]
  coaches   User[]
  tasks     Task[]
  createdAt DateTime    @default(now())
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  phone              String
  passwordHash       String
  role               Role           @default(COACH)
  systemRole         String?        @default("COACH") // CHUNHIEM, PHOCHUNHIEM, CHUCOSO, COACH
  title              String?        // Danh hiệu: Đại Kiện Tướng, HLV Quốc Gia, v.v.
  experience         String?        // Số năm kinh nghiệm / Thành tích
  bio                String?        // Giới thiệu bản thân
  bankAccount        String?        // STK nhận thù lao
  bankName           String?        // Tên ngân hàng
  accountHolder      String?        // Chủ tài khoản
  elo                Int?           @default(2000)
  hasAdminAccess     Boolean        @default(false)
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  classes            Classroom[]
  baseRate           Float          @default(200000) // Đơn giá thù lao/ca dạy của HLV
  tuitionRatePercent Float?         @default(50) // % học phí nhận được
  bookRatePercent    Float?         @default(30) // % tiền sách nhận được
  assignedTasks      Task[]         @relation("AssignedTasks")
  createdTasks       Task[]         @relation("CreatedTasks")
  notifications      Notification[]
  createdAt          DateTime       @default(now())
}

model Classroom {
  id            String              @id @default(uuid())
  name          String              // VD: Cờ vua Nhập Môn - K1
  level         String              // Vỡ lòng, Nhập môn, Nâng cao, Đội tuyển
  feePerSession Float               @default(150000) // Đơn giá học phí / 1 buổi
  schedule      String              // VD: Thứ 3 & Thứ 6 (18:00 - 19:30)
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  coachId       String
  coach         User                @relation(fields: [coachId], references: [id])
  students      ClassStudent[]
  sessions      AttendanceSession[]
  invoices      MonthlyInvoice[]
  isActive      Boolean             @default(true)
  shareWithAdmin Boolean            @default(true)
}

model Student {
  id           String              @id @default(uuid())
  code         String?
  fullName     String
  birthYear    Int?
  gender       String?
  parentName   String?             @default("")
  parentPhone  String
  currentLevel String?             @default("Nhập môn")
  eloRating    Int                 @default(1000)
  notes        String?
  customFeePerSession Float?
  avatar       String?
  address      String?
  school       String?
  status       String?             @default("ACTIVE")
  classes      ClassStudent[]
  attendances  AttendanceRecord[]
  invoices     MonthlyInvoice[]
  evaluations  StudentEvaluation[]
}

model ClassStudent {
  classId   String
  studentId String
  classroom Classroom @relation(fields: [classId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])
  joinedAt  DateTime  @default(now())
  @@id([classId, studentId])
}

model AttendanceSession {
  id        String             @id @default(uuid())
  classId   String
  classroom Classroom          @relation(fields: [classId], references: [id])
  date      DateTime           // Ngày diễn ra buổi học
  topic     String?            // Chủ đề bài học cờ vua
  records   AttendanceRecord[]
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  status    AttendanceStatus  @default(PRESENT)
  coachNote String?           // Nhận xét của HLV
  bookTitle String?           // Tên sách phát
  bookPrice Float?            // Giá sách
}

model MonthlyInvoice {
  id            String        @id @default(uuid())
  invoiceCode   String        @unique // VD: HP-202610-001
  classId       String
  classroom     Classroom     @relation(fields: [classId], references: [id])
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  month         Int           // Tháng
  year          Int           // Năm
  presentCount  Int           // Số buổi Có mặt thực tế
  feePerSession Float         // Đơn giá tại thời điểm xuất
  totalAmount   Float         // presentCount * feePerSession
  status        InvoiceStatus @default(PENDING)
  zaloSentAt    DateTime?
  vietQrUrl     String?
  createdAt     DateTime      @default(now())
}

model StudentEvaluation {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  month       Int
  year        Int
  opening     Int      @default(3) // Khai cuộc (1 - 5 sao)
  tactics     Int      @default(3) // Chiến thuật (1 - 5 sao)
  calculation Int      @default(3) // Tính toán (1 - 5 sao)
  endgame     Int      @default(3) // Tàn cuộc (1 - 5 sao)
  generalNote String?
}

model Task {
  id                String    @id @default(uuid())
  title             String
  description       String?
  category          String?   @default("CHUYEN_MON") // CHUYEN_MON, GIAO_AN, TUYEN_SINH, SU_KIEN, CO_SO, KHAC
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED_PENDING_REVIEW, APPROVED, REJECTED
  kpiPoints         Int       @default(10)
  dueDate           DateTime?
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id])
  assigneeId        String
  assignee          User      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creatorId         String?
  creator           User?     @relation("CreatedTasks", fields: [creatorId], references: [id])
  reportNote        String?
  reportAttachments String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewFeedback    String?
  isCompletedOnTime Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("TASK") // TASK_ASSIGNED, TASK_SUBMITTED, TASK_APPROVED, TASK_REJECTED, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

